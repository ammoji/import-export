# ── SaraStackLabs environment variables ───────────────────────────────
# Copy this file to `.env.local` for local development and set real values.
# On Vercel, add these under Project Settings → Environment Variables.

# Transactional email (Resend) — https://resend.com
# Without RESEND_API_KEY, inquiries are NOT emailed. In development the API
# route logs the payload and returns success so you can test the UI; in
# production a missing key returns an error.
RESEND_API_KEY=

# The verified sender address in your Resend account.
# Defaults to Resend's sandbox "onboarding@resend.dev" if unset.
INQUIRY_FROM_EMAIL=

# Where inquiry emails are delivered. Defaults to the address in
# config/site.ts (currently the placeholder SaraStackLabs@gmail.com).
CONTACT_EMAIL=

# ── Public branding overrides (optional) ──────────────────────────────
# These are read by config/site.ts and let you change contact details per
# deployment without editing code. They are exposed to the browser.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SITE_URL=
