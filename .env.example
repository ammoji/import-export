# ── Farms2World environment variables ─────────────────────────────────
# Copy this file to `.env.local` for local development and set real values.
# On Netlify/Vercel, add these under the project's Environment Variables.

# Transactional email (Resend) — https://resend.com
# Without RESEND_API_KEY, inquiries are NOT emailed; the API route logs the
# payload and returns success so you can test the UI.
RESEND_API_KEY=

# The verified sender address in your Resend account.
# Defaults to Resend's sandbox "onboarding@resend.dev" if unset.
INQUIRY_FROM_EMAIL=

# Where inquiry emails are delivered. Defaults to the address in
# config/site.ts (support@farms2world.com).
CONTACT_EMAIL=

# ── Public branding overrides (optional) ──────────────────────────────
# These are read by config/site.ts and let you change contact details per
# deployment without editing code. They are exposed to the browser.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SITE_URL=
