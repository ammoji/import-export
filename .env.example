# ── Farms2World environment variables ─────────────────────────────────
# Copy this file to `.env.local` for local development and set real values.
# On Netlify, add these under Site configuration → Environment variables.

# ── Inquiry email (Titan SMTP) ────────────────────────────────────────
# The inquiry/quote form sends a notification to your inbox and an
# auto-reply to the customer, via your Titan mailbox over SMTP.
# Without these set, the form still works but emails are only logged.
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USER=support@farms2world.com
SMTP_PASS=

# Where inquiry notifications are delivered (defaults to SMTP_USER).
CONTACT_EMAIL=support@farms2world.com

# ── Public branding overrides (optional) ──────────────────────────────
# Read by config/site.ts to change contact details per deployment without
# editing code. Exposed to the browser.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SITE_URL=https://farms2world.com

# ── WhatsApp notifications via CallMeBot (optional, free) ─────────────
# Sends inquiry details to your WhatsApp number on every form submission.
# One-time setup: https://www.callmebot.com/blog/free-api-whatsapp-messages/
#   1. Save +34 644 52 07 57 in your phone contacts as "CallMeBot"
#   2. Send this exact message to that number on WhatsApp:
#      I allow callmebot to send me messages
#   3. You'll receive an API key — paste it below.
# Leave blank to disable WhatsApp notifications.
WA_CALLMEBOT_KEY=

# ── Analytics (optional) ──────────────────────────────────────────────
# Set to a Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX) to enable
# visitor analytics. Leave blank to disable analytics entirely.
NEXT_PUBLIC_GA_ID=
